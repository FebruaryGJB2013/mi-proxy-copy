# Port the server listens on.
PORT=8080

# Default search engine used when the address bar input isn't a URL.
# "%s" is replaced with the URL-encoded query.
SEARCH_ENGINE=https://www.google.com/search?q=%s

# Wisp (tunnel) server settings -----------------------------------------
# Allow UDP-over-Wisp streams (needed for some real-time sites/games).
WISP_ALLOW_UDP=true

# Comma-separated regexes of hostnames the wisp server refuses to connect to.
WISP_HOSTNAME_BLACKLIST=

# Comma-separated DNS resolvers the wisp server uses for outbound lookups.
WISP_DNS_SERVERS=1.1.1.1,1.0.0.1

# Set to "debug" for verbose wisp server logging.
WISP_LOG_LEVEL=debug

# Port used only by `npm run wisp` (running wisp/standalone.js on its own,
# without the rest of mi-proxy). Ignored by `npm start`.
WISP_PORT=8081
